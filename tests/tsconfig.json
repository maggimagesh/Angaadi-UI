{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Node's type stripping resolves relative imports literally, so the tests
    // import app modules with an explicit ".ts" extension.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    // The Pagination Playground (api/_pagination) is plain JS shared with the Vercel function.
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../src/api/webhook.ts"]
}

{
  "rewrites": [
    {
      "source": "/slow-loading",
      "destination": "/api/slow-loading"
    },
    {
      "source": "/bad-request",
      "destination": "/api/bad-request"
    },
    {
      "source": "/bad-request/:id",
      "destination": "/api/bad-request?id=:id"
    },
    {
      "source": "/((?!api|_next|_static|favicon.ico|logo|images|crawlableDocuments).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
